{
	"name": "michalstaniecko/terminarz",
	"description": "Online appointment booking plugin for WordPress with optional WooCommerce payments.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"autoload": {
		"psr-4": {
			"Terminarz\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"require-dev": {
		"wp-cli/i18n-command": "^2.7"
	},
	"scripts": {
		"i18n": "wp i18n make-pot . languages/terminarz.pot --slug=terminarz --domain=terminarz --exclude=node_modules,vendor,build,tests,docs,artifacts"
	}
}
