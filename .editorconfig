# WordPress coding standards: https://make.wordpress.org/core/handbook/best-practices/coding-standards/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.json,*.json.dist}]
indent_style = tab
