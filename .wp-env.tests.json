{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"testsEnvironment": false,
	"phpVersion": "8.1",
	"port": 8889,
	"mappings": {
		"wp-content/plugins/terminarz": ".",
		"wp-content/plugins/woocommerce": "https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
		"wp-content/mu-plugins": "./tests/e2e/mu-plugins"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": false
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run --config=.wp-env.tests.json cli wp plugin activate terminarz woocommerce"
	}
}
